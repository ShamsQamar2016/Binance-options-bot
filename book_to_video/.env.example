# Claude API калити: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# fal.ai калити (Kling видео модели шу орқали): https://fal.ai/dashboard/keys
FAL_KEY=...
# Видео модели (fal.ai даги ID). Бошқа моделга алмаштириш мумкин.
FAL_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video

# Telegram: @BotFather дан бот токени ва чат ID (@userinfobot орқали билиш мумкин)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# ---------------- Сериал режими (serial.py) ----------------
# Сериал чиқадиган канал. Ботни каналга админ қилиб қўшинг.
TELEGRAM_CHANNEL_ID=@kanal_nomi
# Каналдаги «кейинги қисм эртага соат ... да» ёзуви учун
PUBLISH_TIME=20:00

# Дубляж: azure ёки elevenlabs
TTS_PROVIDER=azure
# Azure (https://portal.azure.com → Speech service). Ўзбекча овозлар бор.
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=westeurope
# ElevenLabs (https://elevenlabs.io) — эмоционалроқ, кўп овозли
ELEVENLABS_API_KEY=...
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_MALE_VOICE=
ELEVENLABS_FEMALE_VOICE=
ELEVENLABS_NARRATOR_VOICE=

# Субтитр: cyrillic ёки latin; 1 — видеога ёзиш, 0 — ёзмаслик
SUBTITLE_SCRIPT=cyrillic
BURN_SUBTITLES=1
# Фон мусиқаси (ихтиёрий, ҳуқуқи ўзингизда бўлган mp3)
BACKGROUND_MUSIC=
# Кирилл ёзувли шрифт (титрлар учун). Windows: C:/Windows/Fonts/arial.ttf
FONT_FILE=
